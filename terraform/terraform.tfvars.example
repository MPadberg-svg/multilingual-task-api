# Copy to terraform/production.tfvars (gitignored) and populate real values before running:
#   terraform init
#   terraform validate
#   terraform plan -var-file="production.tfvars" -out=tfplan

aws_region   = "us-east-1"
project_name = "multilingual-task-api"
environment  = "production"

# Immutable container image tag (e.g. Git commit SHA or release tag pushed to ECR)
image_tag = "v1.11.0"

# GitHub OIDC keyless deployment configuration
github_repository           = "MPadberg-svg/multilingual-task-api"
create_github_oidc_provider = true

# CloudFront L7 WAFv2 & ALB origin-cloaking protection
enable_waf            = true
waf_rate_limit_per_5m = 2000
origin_verify_secret  = "CHANGE_ME_RANDOM_32_BYTE_ORIGIN_SECRET"

# Custom API domain & ACM TLS certificate ARN (enables HTTPS:443 + HTTP->HTTPS 301 redirect)
domain_name         = "api.example.com"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Optional OTLP/HTTP trace collector endpoint
otel_exporter_otlp_endpoint = ""

# Database sizing & bootstrap master password (pass via TF_VAR_db_password in CI)
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_name              = "multilingual_task_api"
db_username          = "postgres"
db_password          = "CHANGE_ME_STRONG_RDS_PASSWORD"

# Optional RDS PostgreSQL 16 read replica & CloudWatch alarm routing
enable_read_replica       = true
db_replica_instance_class = ""
replica_lag_alarm_seconds = 30
alert_sns_topic_arn       = ""

# S3 Object Lock WORM audit checkpointing, KMS transparency & ECS/Celery autoscaling
enable_audit_worm_bucket          = true
audit_worm_retention_days         = 365
enable_audit_kms_signing          = true
alb_requests_per_target           = 600
celery_max_capacity               = 6
celery_backlog_target_per_worker  = 50
celery_backlog_alarm_threshold    = 250
active_learning_entropy_threshold = 0.78
enable_dataset_export_bucket      = true
dataset_export_retention_days     = 90

# Redis & ECS Fargate sizing
redis_node_type   = "cache.t3.micro"
ecs_desired_count = 2
ecs_task_cpu      = "512"
ecs_task_memory   = "1024"

# Secrets Manager / SSM Parameter ARNs injected into ECS API & Celery containers
django_secret_key_arn     = "arn:aws:secretsmanager:us-east-1:123456789012:secret:multilingual-task-api/production/SECRET_KEY"
db_password_secret_arn    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:multilingual-task-api/production/POSTGRES_PASSWORD"
openai_api_key_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:multilingual-task-api/production/OPENAI_API_KEY"
metrics_token_secret_arn  = ""
